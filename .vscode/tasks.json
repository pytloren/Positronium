{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Positronium: build (MSVC x64 + CERN ROOT)",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "\"${workspaceFolder}\\build.cmd\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Positronium: run with CMake",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "\"${workspaceFolder}\\run.cmd\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
