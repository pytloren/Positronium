{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Positronium: debug (MSVC x64 + CERN ROOT)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\cmake\\Release\\Positronium.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "ROOTSYS",
          "value": "C:\\Root"
        },
        {
          "name": "PATH",
          "value": "C:\\Root\\bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "preLaunchTask": "Positronium: build (MSVC x64 + CERN ROOT)"
    }
  ]
}
